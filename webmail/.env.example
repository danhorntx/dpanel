# ─── DPanel webmail ───────────────────────────────────────────────────────────
# Vendored from duperhuman, runs as a sibling service to DPanel and is the
# backend for webmail.<domain>. Defaults assume the server is co-located with
# Dovecot/Postfix on localhost.

# Listen on a non-conflicting port; Apache reverse-proxies webmail.<domain>/api
# to this address.
PORT=3501
NODE_ENV=production

# Required. Encrypts the IMAP password held inside the session cookie.
# Generate with: openssl rand -hex 32
DPANEL_COOKIE_SECRET=

# Turn on DPanel multi-tenant mode (login via IMAP probe, Gmail UI hidden,
# routes session-scoped, accountId rewriting).
DPANEL_MODE=true

# Where the auth probe + outgoing sends connect to. Loopback to Dovecot/Postfix.
# Dovecot on localhost presents a cert for mail.<domain>, not 127.0.0.1, so
# disable strict TLS verification for the local hop.
DPANEL_IMAP_HOST=127.0.0.1
DPANEL_IMAP_PORT=993
DPANEL_IMAP_TLS=true
DPANEL_SMTP_HOST=127.0.0.1
DPANEL_SMTP_PORT=587
DPANEL_SMTP_SECURE=false
ALLOW_INSECURE_MAIL_TLS=true

# Sync cadence
SYNC_INTERVAL_MS=30000
INITIAL_SYNC_LIMIT=200
